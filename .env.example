# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Neon PostgreSQL ──────────────────────────────────────
# Connection string from your Neon project dashboard.
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/avatition?sslmode=require

# ── Login security ───────────────────────────────────────
# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace_with_a_long_random_string_of_at_least_32_chars

# ── Google Gemini (optional) ─────────────────────────────
# Without a key the app still works in direct mode (rules, no AI).
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model for understanding questions and writing summaries
GEMINI_MODEL=gemini-2.5-flash
# Model for embeddings (output is 768 dimensions, matching the database)
EMBEDDING_MODEL=gemini-embedding-001

# ── Ranking weights (must sum to 1.0) ────────────────────
WEIGHT_KEYWORD=0.20
WEIGHT_VECTOR=0.30
WEIGHT_PREFERENCE=0.50

