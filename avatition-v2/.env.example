# Copy this file to ".env" (same folder) and fill in the values. Never commit ".env".

# From the Neon dashboard: Connect -> copy the connection string. It looks like
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Needed later, for the Gemini step (from Google AI Studio).
GEMINI_API_KEY=
# Model names are chosen at the Gemini step; leave blank for now.
GEMINI_MODEL=
EMBEDDING_MODEL=
